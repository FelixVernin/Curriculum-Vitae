{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felix-portfolio-chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ALLOWED_ORIGINS": "https://curriculum-vitae.felix-vernin.workers.dev",
    "CHATBOT_ENABLED": "true"
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHATBOT_RATE_LIMITER",
      "namespace_id": "20261013",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}

---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import site from '../data/site'
---
<Base title={`${site.name} — ${site.position}`}>
  <Header slot="header" />

  <section id="presentation" class="hero">
    <div class="inner">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Portfolio / ingénierie IA / 2026</p>
          <h2>Je transforme<br /><span>des signaux</span><br />en décisions.</h2>
          <p class="lead">Je conçois des pipelines de machine learning lisibles, testables et utiles : de la donnée brute à une interface que l’on peut vraiment utiliser.</p>
          <p class="actions"><a href="#projects" class="btn">Explorer les projets</a> <a href={site.cvPath} class="btn muted">Ouvrir le CV</a></p>
        </div>
        <aside class="signal-panel" aria-label="Console de pipeline machine learning">
          <div class="panel-top"><span>MODEL_SIGNAL / 001</span><span class="live">LIVE</span></div>
          <div class="console">
            <div class="console-line"><span>input.stream</span><strong class="console-value">PWV_DATA</strong></div>
            <div class="console-line"><span>model.family</span><strong class="console-value">ENSEMBLE</strong></div>
            <div><div class="console-line"><span>confidence</span><strong class="console-value" data-confidence>0.87</strong></div><div class="console-bar"><i data-confidence-bar></i></div></div>
            <div class="console-line"><span>status</span><strong class="console-value" data-console-status>READY_TO_SHIP</strong></div>
            <button class="console-button" type="button" data-run-signal>› lancer une nouvelle inférence</button>
          </div>
        </aside>
      </div>
      <div class="hero-foot">
        <div class="metric"><strong>02</strong><span>expériences terrain</span></div>
        <div class="metric"><strong>04</strong><span>projets publics</span></div>
        <div class="metric"><strong>810</strong><span>score TOEIC</span></div>
        <div class="metric"><strong>06</strong><span>familles de modèles testées</span></div>
      </div>
    </div>
  </section>

  <section id="experiences" class="section">
    <div class="inner">
      <div class="section-heading"><h3>Terrain de jeu</h3><span class="section-index">02 / expériences</span></div>
      <div class="experiences">
        {site.experiences?.map((e, index) => (
          <article class="experience" style={`animation-delay: ${index * 120}ms`}>
            <div><h4>{e.org}</h4><p class="meta">{e.period}{e.location ? ` / ${e.location}` : ''}</p></div>
            <div><p>{e.descriptionFr}</p><p class="tech">{e.technologies?.join(' · ')}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="inner">
      <div class="section-heading"><h3>Projets sélectionnés</h3><span class="section-index">03 / laboratoire</span></div>
      <div class="filter-bar" aria-label="Filtrer les projets">
        <button class="filter" type="button" data-filter="all" aria-pressed="true">Tous</button>
        <button class="filter" type="button" data-filter="AI" aria-pressed="false">IA / ML</button>
        <button class="filter" type="button" data-filter="Product" aria-pressed="false">Produit</button>
        <button class="filter" type="button" data-filter="Design" aria-pressed="false">Design</button>
        <button class="filter" type="button" data-filter="Data" aria-pressed="false">Data</button>
      </div>
      <ul class="projects">
        {site.projects.map((p, index) => (
          <li class="project" data-project-kind={p.kind}>
            <div class="project-top"><span>0{index + 1} / {p.kind}</span><span class="project-kind">{p.tags[0]}</span></div>
            <h4>{p.title}</h4><p>{p.description}</p>
            <div class="tags">{p.tags.map(tag => <span class="tag">{tag}</span>)}</div>
            {p.github ? <a class="project-link" href={p.github} target="_blank" rel="noopener">Voir le repository</a> : null}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="skills-education" class="section">
    <div class="inner profile-grid">
      <div><div class="section-heading"><h3>Fondations</h3><span class="section-index">04 / socle</span></div><div class="profile-block edu"><h4>Formation</h4><ul>{site.education?.map(ed => <li><strong>{ed.period}</strong> {ed.title}<br /><span class="meta">{ed.place}</span></li>)}</ul></div></div>
      <div><div class="profile-block"><h4>Compétences</h4><div class="skills">{site.skills?.flatMap(s => s.items).map(skill => <p>{skill}</p>)}</div></div><div class="profile-block langs"><h4>Langues</h4><p>{site.languages?.map(l => `${l.name} / ${l.level}`).join(' · ')}</p></div></div>
    </div>
  </section>

  <section id="contact" class="section"><div class="inner contact-section"><div><p class="eyebrow">Dernier bloc / contact</p><h3>Construisons quelque chose de précis.</h3></div><div><p class="contact-copy">Disponible pour un CDI en machine learning, data ou ingénierie IA.</p><p class="contact-links"><button class="copy-email" type="button" data-copy-email={site.contact?.email}>Copier l’email</button><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a><a href={site.githubProfile} target="_blank" rel="noopener">GitHub ↗</a></p></div></div></section>

  <Footer slot="footer" />
</Base>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  const projects = document.querySelectorAll<HTMLElement>('[data-project-kind]')
  filters.forEach((filter) => filter.addEventListener('click', () => {
    const value = filter.dataset.filter
    filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)))
    projects.forEach((project) => project.classList.toggle('is-hidden', value !== 'all' && project.dataset.projectKind !== value))
  }))

  const signalButton = document.querySelector<HTMLButtonElement>('[data-run-signal]')
  signalButton?.addEventListener('click', () => {
    const confidence = (0.72 + Math.random() * 0.24).toFixed(2)
    document.querySelector('[data-confidence]')!.textContent = confidence
    document.querySelector('[data-confidence-bar]')!.setAttribute('style', `width: ${Number(confidence) * 100}%`)
    document.querySelector('[data-console-status]')!.textContent = 'INFERENCE_DONE'
    window.setTimeout(() => { document.querySelector('[data-console-status]')!.textContent = 'READY_TO_SHIP' }, 1800)
  })

  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]')
  copyButton?.addEventListener('click', async () => {
    if (!copyButton.dataset.copyEmail) return
    await navigator.clipboard.writeText(copyButton.dataset.copyEmail)
    copyButton.textContent = 'Email copié ✓'
    window.setTimeout(() => { copyButton.textContent = 'Copier l’email' }, 1800)
  })
</script>

---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import site from '../data/site'
---
<Base title={`${site.name} — ${site.position}`}>
  <Header slot="header" />

  <section id="presentation" class="hero">
    <div class="inner">
      <h2>{site.name}</h2>
      <p class="lead">{site.position}. Je conçois des pipelines de machine learning, de la préparation des données à l’évaluation des modèles et à la restitution des résultats.</p>
      <p class="actions"><a href="#projects" class="btn">Voir mes projets</a> <a href={site.cvPath} class="btn muted">Consulter mon CV</a></p>
    </div>
  </section>

  <section id="experiences" class="section">
    <div class="inner">
      <h3>Expériences</h3>
      <div class="experiences">
        {site.experiences?.map(e => (
          <article class="experience">
            <h4>{e.org}</h4>
            <p class="meta">{e.role} {e.period ? `— ${e.period}` : ''} {e.location ? `— ${e.location}` : ''}</p>
            <p>{e.descriptionFr}</p>
            {e.technologies && e.technologies.length ? <p class="tech">Tech: {e.technologies.join(', ')}</p> : null}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="section">
    <div class="inner">
      <h3>Projets</h3>
      <ul class="projects">
        {site.projects.map(p => (
          <li>
            <h4>{p.title}</h4>
            <p>{p.description}</p>
            {p.github ? <p><a href={p.github} target="_blank" rel="noopener">Voir le code sur GitHub</a></p> : null}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="skills-education" class="section">
    <div class="inner">
      <h3>Compétences & Formation</h3>
      <div class="edu">
        <h4>Formation</h4>
        <ul>
          {site.education?.map(ed => (
            <li><strong>{ed.period}</strong> — {ed.title}, {ed.place}{ed.details ? ` — ${ed.details}` : ''}</li>
          ))}
        </ul>
      </div>
      <div class="skills">
        <h4>Compétences</h4>
        {site.skills?.map(s => (
          <p><strong>{s.category}:</strong> {s.items.join(', ')}</p>
        ))}
      </div>
      <div class="langs">
        <h4>Langues</h4>
        <p>{site.languages?.map(l => `${l.name} (${l.level})`).join(' · ')}</p>
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="inner">
      <h3>Contact</h3>
      {site.contact?.email ? <p>Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p> : null}
      {site.contact?.phone ? <p>Tél: <a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a></p> : null}
      <p>LinkedIn: <a href={site.linkedin} target="_blank" rel="noopener">profil</a> — GitHub: <a href={site.githubProfile} target="_blank" rel="noopener">profil</a></p>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

---
import type { SiteData } from '../data/site'
import '../styles.css'
import Chatbot from '../components/Chatbot.astro'
const { title = 'Portfolio' } = Astro.props
const language = Astro.url.pathname.startsWith('/en') ? 'en' : 'fr'
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Aller au contenu</a>
    <slot name="header" />
    <main id="content">
      <slot />
    </main>
    <slot name="footer" />
    <Chatbot />
  </body>
</html>
